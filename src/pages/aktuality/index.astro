---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import { base } from '../../utils/base';

const polozky = (await getCollection('aktuality')).sort(
  (a, b) => b.data.datum.valueOf() - a.data.datum.valueOf()
);
---

<Layout title="Aktuality" popis="Novinky a oznámení komise místní samosprávy.">
  <section class="sekce">
    <div class="obsah">
      <div class="sekce__hlavicka">
        <div>
          <h1>Aktuality</h1>
          <p>Průběžné novinky, oznámení a shrnutí z práce komise.</p>
        </div>
      </div>

      {polozky.length > 0 ? (
        <div class="mrizka mrizka--3">
          {polozky.map((polozka) => (
            <Card
              href={`${base}aktuality/${polozka.id}/`}
              title={polozka.data.title}
              perex={polozka.data.perex}
              datum={polozka.data.datum}
              obrazek={polozka.data.obrazek}
            />
          ))}
        </div>
      ) : (
        <p class="prazdny-stav">Zatím žádné aktuality.</p>
      )}
    </div>
  </section>
</Layout>
